{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Material",
	"description": "Bold solid surfaces with crisp 3D edges and a printed/stamped feel. Indigo brand preserved.",
	"settings": {
		"custom": {
			"_notes": {
				"intent": "Solid tonal surfaces on indigo-tinted backgrounds. No backdrop blur. Shadows are short and high-contrast with a fixed bottom edge for a stamped feel. Buttons have a flat bottom edge that compresses on press.",
				"consumed-by": "styles/lumio-surfaces.css — provides .glass primitive and reads these tokens.",
				"preserves": [
					"indigo brand palette",
					"Outfit / Fira Sans / Fira Code",
					"fluid type",
					"9-step spacing"
				]
			},
			"radius": {
				"default": "24px",
				"xs": "6px",
				"sm": "10px",
				"md": "14px",
				"lg": "24px",
				"xl": "32px",
				"pill": "999px"
			},
			"page": {
				"bg": "radial-gradient(1000px 700px at 0% 0%, var(--wp--preset--color--brand-soft) 0%, transparent 55%), radial-gradient(900px 700px at 100% 0%, var(--wp--preset--color--background-alt) 0%, transparent 55%), var(--wp--preset--color--background)"
			},
			"surface": {
				"bg": "var(--wp--preset--color--surface)",
				"bg-strong": "var(--wp--preset--color--background-subtle)",
				"blur": "none",
				"border": "1.5px solid var(--wp--preset--color--border)",
				"specular": "none"
			},
			"shadow": {
				"scale": "1",
				"elev-0": "0 0 0 1px var(--wp--preset--color--border)",
				"elev-1": "0 1px 0 var(--wp--preset--color--border), 0 0 0 1px var(--wp--preset--color--border)",
				"elev-2": "0 2px 0 var(--wp--preset--color--border), 0 8px 24px -8px rgba(14, 14, 85, 0.12), 0 0 0 1px var(--wp--preset--color--border)",
				"elev-3": "0 4px 0 var(--wp--preset--color--border), 0 20px 40px -12px rgba(14, 14, 85, 0.20), 0 0 0 1px var(--wp--preset--color--border)",
				"elev-4": "0 6px 0 var(--wp--preset--color--border), 0 32px 56px -16px rgba(14, 14, 85, 0.30), 0 0 0 1px var(--wp--preset--color--border)"
			},
			"btn": {
				"brand-bg": "var(--wp--preset--color--brand)",
				"brand-shadow": "0 4px 0 var(--wp--preset--color--brand-deep), 0 6px 16px -4px rgba(67, 67, 215, 0.4)"
			},
			"focus": {
				"ring": "0 0 0 4px rgba(67, 67, 215, 0.22), 0 0 0 1.5px rgba(67, 67, 215, 0.85), 0 6px 18px -4px rgba(67, 67, 215, 0.35)"
			},
			"motion": {
				"ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
				"ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
				"t-fast": "120ms",
				"t-med": "220ms",
				"t-slow": "360ms"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)"
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--custom--btn--brand-bg)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "24px",
						"bottom": "14px",
						"left": "24px"
					}
				}
			},
			"core/post-terms": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			}
		}
	}
}
