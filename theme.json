{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"allowCustomContentAndWideSize": false,
			"contentSize": "740px",
			"wideSize": "960px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "text",              "color": "#0d0d10", "name": "Text" },
				{ "slug": "text-body",         "color": "#212126", "name": "Text Body" },
				{ "slug": "text-secondary",    "color": "#404048", "name": "Text Secondary" },
				{ "slug": "text-muted",        "color": "#61616b", "name": "Text Muted" },
				{ "slug": "text-subtle",       "color": "#85858d", "name": "Text Subtle" },
				{ "slug": "text-on-dark",      "color": "#e9e9ee", "name": "Text On Dark" },

				{ "slug": "background",        "color": "#eef0fb", "name": "Background" },
				{ "slug": "background-alt",    "color": "#e2e6f5", "name": "Background Alt" },
				{ "slug": "background-subtle", "color": "#f6f7fc", "name": "Background Subtle" },
				{ "slug": "surface",           "color": "#ffffff", "name": "Surface" },

				{ "slug": "border",            "color": "#d6daec", "name": "Border" },
				{ "slug": "border-strong",     "color": "#d2d2d5", "name": "Border Strong" },

				{ "slug": "brand-soft",        "color": "#f0f0fc", "name": "Brand Soft" },
				{ "slug": "brand-200",         "color": "#c5c5f5", "name": "Brand 200" },
				{ "slug": "brand-300",         "color": "#9a9aee", "name": "Brand 300" },
				{ "slug": "brand",             "color": "#4343d7", "name": "Brand" },
				{ "slug": "brand-hover",       "color": "#23239f", "name": "Brand Hover" },
				{ "slug": "brand-deep",        "color": "#0e0e55", "name": "Brand Deep" },

				{ "slug": "link-visited",      "color": "#4747d4", "name": "Link Visited" },
				{ "slug": "link-visited-deep", "color": "#2626a0", "name": "Link Visited Deep" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "'Outfit', system-ui, sans-serif",
					"name": "Outfit",
					"slug": "outfit",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/outfit/outfit-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Outfit",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/outfit/outfit-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
