							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-500-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-500-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-600-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-600-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-700-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/fira-sans-700-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"fontFamily": "'Fira Code', ui-monospace, monospace",
					"name": "Fira Code",
					"slug": "fira-code",
					"fontFace": [
						{
							"fontFamily": "Fira Code",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-code/fira-code-400-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fira Code",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-code/fira-code-400-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fira Code",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-code/fira-code-500-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Fira Code",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-code/fira-code-500-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS — Caption / metadata",
					"size": "clamp(0.625rem, 0.44vw + 0.52rem, 0.75rem)",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "SM — Small print / footnotes",
					"size": "clamp(0.8125rem, 0.22vw + 0.75rem, 0.875rem)",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base — Body copy",
					"size": "clamp(1rem, 0.44vw + 0.9rem, 1.125rem)",
					"fluid": false
				},
				{
					"slug": "md",
					"name": "MD — Lead paragraph",
					"size": "clamp(1.25rem, 0.66vw + 1.1rem, 1.4375rem)",
					"fluid": false
				},
				{
					"slug": "lg",
					"name": "LG — H3 / Subheading",
					"size": "clamp(1.5625rem, 0.66vw + 1.4rem, 1.75rem)",
					"fluid": false
				},
				{
					"slug": "xl",
					"name": "XL — H2 / Section heading",
					"size": "clamp(1.9375rem, 0.88vw + 1.72rem, 2.1875rem)",
					"fluid": false
				},
				{
					"slug": "2xl",
					"name": "2XL — H1 / Post title",
					"size": "clamp(2.4375rem, 1.1vw + 2.16rem, 2.75rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "1", "size": "4px",  "name": "1" },
				{ "slug": "2", "size": "8px",  "name": "2" },
				{ "slug": "3", "size": "12px", "name": "3" },
				{ "slug": "4", "size": "16px", "name": "4" },
				{ "slug": "5", "size": "24px", "name": "5" },
				{ "slug": "6", "size": "32px", "name": "6" },
				{ "slug": "7", "size": "48px", "name": "7" },
				{ "slug": "8", "size": "64px", "name": "8" },
				{ "slug": "9", "size": "96px", "name": "9" }
			]
		},
		"border": {
			"defaultRadius": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "focus",
					"name": "Focus ring",
					"shadow": "0 0 0 3px var(--wp--preset--color--brand-soft)"
				},
				{
					"slug": "card-hover",
					"name": "Card hover",
					"shadow": "0 4px 20px color-mix(in srgb, var(--wp--preset--color--brand) 8%, transparent)"
				}
			]
		},
		"custom": {
			"radius": {
				"default": "10px",
				"sm": "6px",
				"xs": "4px"
			},
			"transition": {
				"fast": "0.15s",
				"instant": "0.05s"
			},
			"color": {
				"danger": "#9a1c1c",
				"danger-soft": "#f8e4e4"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--fira-sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--5)",
			"padding": {
				"left": "var(--wp--preset--spacing--5)",
				"right": "var(--wp--preset--spacing--5)"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.025em"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--xl)",
					"fontWeight": "500",
					"lineHeight": "1.25",
					"letterSpacing": "-0.025em"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--lg)",
					"fontWeight": "500",
					"lineHeight": "1.35",
					"letterSpacing": "-0.015em"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--md)",
					"fontWeight": "500",
					"lineHeight": "1.65"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600",
					"lineHeight": "1.75"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "600",
					"lineHeight": "1.5"
				},
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--brand-hover)" },
				"typography": { "textDecoration": "underline" },
				":hover":   { "color": { "text": "var(--wp--preset--color--brand-deep)" } },
				":visited": { "color": { "text": "var(--wp--preset--color--link-visited-deep)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--surface)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-sans)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"letterSpacing": "-0.005em"
				},
				"border": { "radius": "8px" },
				"spacing": {
					"padding": { "top": "11px", "right": "20px", "bottom": "11px", "left": "20px" }
				},
				":hover": { "color": { "background": "var(--wp--preset--color--brand-hover)" } }
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontSize": "var(--wp--preset--font-size--xs)",
					"letterSpacing": "0.04em",
					"textAlign": "center"
				},
				"color": { "text": "var(--wp--preset--color--text-muted)" },
				"spacing": { "margin": { "top": "10px" } }
			},
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-sans)",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontStyle": "normal",
					"letterSpacing": "0"
				},
				"color": { "text": "var(--wp--preset--color--text-muted)" },
				"spacing": { "margin": { "top": "12px" } }
			},
			"textInput": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-sans)",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--border-strong)",
					"radius": "var(--wp--custom--radius--sm)"
				},
				"spacing": {
					"padding": { "top": "11px", "right": "14px", "bottom": "11px", "left": "14px" }
				}
			},
			"select": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-sans)",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--border-strong)",
					"radius": "var(--wp--custom--radius--sm)"
				},
				"spacing": {
					"padding": { "top": "11px", "right": "36px", "bottom": "11px", "left": "14px" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--outfit)",
					"fontSize": "18px",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
