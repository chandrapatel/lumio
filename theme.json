{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"allowCustomContentAndWideSize": false,
			"contentSize": "740px",
			"wideSize": "960px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink",        "color": "#0d0d10", "name": "Ink" },
				{ "slug": "paper",      "color": "#eef0fb", "name": "Paper" },
				{ "slug": "paper-2",    "color": "#e2e6f5", "name": "Paper 2" },
				{ "slug": "paper-3",    "color": "#f6f7fc", "name": "Paper 3" },
				{ "slug": "surface",    "color": "#ffffff",  "name": "Surface" },
				{ "slug": "rule",       "color": "#d6daec", "name": "Rule" },

				{ "slug": "brand-soft", "color": "#f0f0fc", "name": "Brand Soft" },
				{ "slug": "brand",      "color": "#4343d7", "name": "Brand" },
				{ "slug": "brand-deep", "color": "#0e0e55", "name": "Brand Deep" },

				{ "slug": "neutral-200", "color": "#d2d2d5", "name": "Neutral 200" },
				{ "slug": "neutral-400", "color": "#85858d", "name": "Neutral 400" },
				{ "slug": "neutral-500", "color": "#61616b", "name": "Neutral 500" },
				{ "slug": "neutral-600", "color": "#404048", "name": "Neutral 600" },
				{ "slug": "neutral-700", "color": "#212126", "name": "Neutral 700" },

				{ "slug": "violet-500", "color": "#4747d4", "name": "Violet 500" },
				{ "slug": "violet-600", "color": "#2626a0", "name": "Violet 600" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
